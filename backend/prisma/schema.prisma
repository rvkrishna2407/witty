generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

//defining the schema of our application

model User{
    id          String       @id        @default(uuid())    
    email       String      @unique
    provider    AuthProvider
    name        String
    conversations Conversation[]
    supabaseId  String      
}

enum AuthProvider {
    Google
    Github
}

model Conversation{
    id         String       @id        @default(uuid())
    title      String?
    slug       String
    userId     String
    messages   Message[]
    user       User         @relation(fields: [userId], references: [id])
}

model Message{
    id         Int       @id        @default(autoincrement()) //the bigger it was the later it came 
    content    String
    role       MessageRole
    conversationId String
    createdAt  DateTime     @default(now())
    conversation Conversation @relation(fields: [conversationId], references: [id])
}

enum MessageRole{
    User
    Assistant 
}